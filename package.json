{
  "name": "starintel_doc",
  "version": "0.10.1",
  "description": "StarLang-generated StarIntel 0.10.1 runtime with explicit historical compatibility",
  "main": "./src/index.js",
  "browser": "./src/index.js",
  "bin": {
    "starintel-conformance": "./bin/starintel-conformance.js",
    "starintel-canonical": "./bin/starintel-canonical.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.mts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "default": "./src/index.js"
    },
    "./conformance": "./src/v090.js",
    "./schema": "./schemas/starintel-0.10.1/generated/schema.json",
    "./schema/expansion": "./schema/starintel-doc-v0.9.0.expansion.json",
    "./schema/manifest": "./schema/starintel-doc-v0.9.0.manifest.json",
    "./legacy": "./src/legacy.js",
    "./canonical": "./src/canonical.js",
    "./types": {
      "types": "./src/canonical-types.d.ts",
      "default": "./schemas/starintel-0.10.1/generated/starintel_types.ts"
    },
    "./fixtures/supported-workflows": "./schemas/starintel-0.10.1/supported-workflow-fixtures.json"
  },
  "files": [
    "bin",
    "src",
    "schema",
    "README.md",
    "LICENSE",
    "schemas"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "conformance": "node ./bin/starintel-conformance.js",
    "check": "node --check src/index.js && node --check src/v090.js && node --check src/document.js && node --check src/schema-bundle.js && node --check src/schema-org.js && node --check src/validation.js && node --check scripts/sync-schema.mjs && node --check scripts/test.mjs && node --check src/canonical.js && node --check bin/starintel-canonical.js",
    "check-schema": "python3 scripts/sync-starintel-schema.py --offline && node scripts/sync-schema.mjs --offline --check",
    "sync-schema": "python3 scripts/sync-starintel-schema.py",
    "prepack": "npm run check-schema && npm run check && npm test && test -s schema/starintel-doc-v0.9.0.schema.json && test -s schema/starintel-doc-v0.9.0.expansion.json && test -s schema/starintel-doc-v0.9.0.manifest.json"
  },
  "keywords": [
    "starintel",
    "osint",
    "json-schema",
    "json-ld",
    "schema.org",
    "conformance",
    "validation",
    "pouchdb",
    "couchdb"
  ],
  "author": "nsaspy",
  "license": "GPLv3",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dataclass": "^2.1.1",
    "lossless-json": "^4.3.0",
    "md5": "^2.3.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.9.3"
  },
  "types": "./src/index.d.ts"
}
